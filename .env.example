# .env.example
# Copy this file to .env and adjust values as needed.
# The system reads config.py directly; this file documents all tunable knobs.
# If you use python-dotenv, load it at the top of config.py.

# ── URLs ───────────────────────────────────────────────────────────────────────
BASE_URL=https://crex.com
MATCH_DETAIL_BASE=https://crex.com/cricket-live-score

# ── Polling Intervals (seconds) ────────────────────────────────────────────────
SCHEDULE_POLL_INTERVAL=300
LIVE_POLL_INTERVAL=30
SCORECARD_POLL_INTERVAL=60
PRE_WARM_SECONDS=120

# ── Browser / Concurrency ──────────────────────────────────────────────────────
HEADLESS=true
BROWSER_POOL_SIZE=3
PAGE_TIMEOUT_MS=30000
NETWORK_IDLE_TIMEOUT_MS=10000

# ── Retry / Back-off ──────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY=2.0

# ── Anti-detection ────────────────────────────────────────────────────────────
MIN_REQUEST_DELAY=1.0
MAX_REQUEST_DELAY=3.0

# ── Storage ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=output

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=logs/crickey.log
LOG_LEVEL=DEBUG
LOG_ROTATION=10 MB
